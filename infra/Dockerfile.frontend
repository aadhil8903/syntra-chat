# Frontend Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY packages/shared-types ./packages/shared-types
COPY apps/frontend ./apps/frontend

RUN npm install
RUN npm run build --workspace=packages/shared-types
RUN npm run build --workspace=apps/frontend

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/frontend/dist/frontend/browser /usr/share/nginx/html

# Environment variables to substitute in templates (prevents wiping $uri, $host, etc.)
ENV NGINX_ENVSUBST_FILTER="PORT BACKEND_URL"

# Default template processed by nginx entrypoint envsubst into /etc/nginx/conf.d/default.conf
RUN mkdir -p /etc/nginx/templates
COPY <<'EOF' /etc/nginx/templates/default.conf.template
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100M;

    # Normal Angular SPA routing - fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy /api/ to the backend service
    location /api/ {
        resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;
        set $upstream_backend "${BACKEND_URL}";

        proxy_pass $upstream_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
EOF

# Initialize default environment variables before envsubst runs
COPY <<'EOF' /docker-entrypoint.d/15-init-defaults.sh
#!/bin/sh
set -e
export PORT="${PORT:-80}"
export BACKEND_URL="${BACKEND_URL:-http://backend:3000}"
# Strip trailing slash from BACKEND_URL if present
export BACKEND_URL="$(echo "$BACKEND_URL" | sed 's:/*$::')"
export NGINX_ENVSUBST_FILTER="PORT BACKEND_URL"
EOF
RUN chmod +x /docker-entrypoint.d/15-init-defaults.sh

# Ensure runtime config.js does not contain hardcoded localhost
COPY <<'EOF' /docker-entrypoint.d/40-inject-config.sh
#!/bin/sh
set -e
cat <<CONFIG_EOF > /usr/share/nginx/html/config.js
window.__APP_CONFIG__ = {
  apiBaseUrl: ""
};
CONFIG_EOF
EOF
RUN chmod +x /docker-entrypoint.d/40-inject-config.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

