        <mxCell id="entity_role" parent="1" style="rounded=1;whiteSpace=wrap;html=1;snapToPoint=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontFamily=Helvetica;" value="&lt;div style=&#39;background-color: #7e22ce; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;&#39;&gt;ROLE&lt;div style=&#39;font-size: 10px; font-weight: normal; opacity: 0.85;&#39;&gt;Collection: roles&lt;/div&gt;&lt;/div&gt;&lt;div style=&#39;font-size: 11px; line-height: 1.45; font-family: monospace;&#39;&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;ObjectId&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ name&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Required]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ key&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Unique, Indexed]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ description&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Optional Note]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ allowedFolders&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string[]&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ permissions&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string[]&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ isSystem&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;boolean&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Default: false]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
