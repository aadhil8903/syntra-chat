        <mxCell id="entity_access_request" parent="1" style="rounded=1;whiteSpace=wrap;html=1;snapToPoint=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontFamily=Helvetica;" value="&lt;div style=&#39;background-color: #b45309; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;&#39;&gt;ACCESSREQUEST&lt;div style=&#39;font-size: 10px; font-weight: normal; opacity: 0.85;&#39;&gt;Collection: access_requests&lt;/div&gt;&lt;/div&gt;&lt;div style=&#39;font-size: 11px; line-height: 1.45; font-family: monospace;&#39;&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;ObjectId&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ userId&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;ObjectId&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[FK -&gt; User]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ resourceId&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[FK -&gt; Target Resource]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ resourceType&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;ResourceType&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Enum: doc|dataset|folder]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ resourceName&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Optional Cache]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ folderPath&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Optional Path]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ reason&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;string&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[User Justification]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ status&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;AccessRequestStatus&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Enum: pending|approved|rejected]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ resolvedBy&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;ObjectId&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[FK -&gt; User (Resolver)]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ resolvedAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
