atedAt&lt;/b&gt;: &lt;span style=&#39;color: #2563eb;&#39;&gt;Date&lt;/span&gt; &lt;span style=&#39;color: #6b7280; font-size: 10px;&#39;&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
