        <mxCell id="entity_user" parent="1" vertex="1" value="&lt;div style='background-color: #7e22ce; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;'&gt;USER&lt;div style='font-size: 10px; font-weight: normal; opacity: 0.85;'&gt;Collection: users&lt;/div&gt;&lt;/div&gt;&lt;div style='font-size: 11px; line-height: 1.45; font-family: monospace;'&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;ObjectId&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ email&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Unique, Lowercase]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ passwordHash&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Hashed Password]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ firstName&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Required]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ lastName&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Required]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ role&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string | UserRole&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[FK -&gt; Role.key]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ departments&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[ACL Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ allowedFolders&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[ACL Allow List]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ deniedFolders&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[ACL Deny List]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ status&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;'active'|'suspended'&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Status Enum]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ onboardingCompleted&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;boolean&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Boolean Flag]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ mustChangePassword&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;boolean&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Boolean Flag]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;snapToPoint=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontFamily=Helvetica;">
