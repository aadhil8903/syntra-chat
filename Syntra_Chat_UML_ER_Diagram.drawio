        <mxCell id="entity_system_setting" parent="1" vertex="1" value="&lt;div style='background-color: #334155; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;'&gt;SYSTEMSETTING&lt;div style='font-size: 10px; font-weight: normal; opacity: 0.85;'&gt;Collection: system_settings&lt;/div&gt;&lt;/div&gt;&lt;div style='font-size: 11px; line-height: 1.45; font-family: monospace;'&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;ObjectId&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ key&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Unique, Indexed Key]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ value&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Configuration Value]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ description&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Optional Note]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedBy&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Modifier Email/ID]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;snapToPoint=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontFamily=Helvetica;">
