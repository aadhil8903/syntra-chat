        <mxCell id="entity_role" parent="1" vertex="1" value="&lt;div style='background-color: #7e22ce; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;'&gt;ROLE&lt;div style='font-size: 10px; font-weight: normal; opacity: 0.85;'&gt;Collection: roles&lt;/div&gt;&lt;/div&gt;&lt;div style='font-size: 11px; line-height: 1.45; font-family: monospace;'&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;ObjectId&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ name&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Required]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ key&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Unique, Indexed]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ description&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Optional Note]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ allowedFolders&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ permissions&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ isSystem&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;boolean&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Default: false]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&