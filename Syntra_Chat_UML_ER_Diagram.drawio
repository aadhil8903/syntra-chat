        <mxCell id="entity_document" parent="1" vertex="1" value="&lt;div style='background-color: #0369a1; color: #ffffff; padding: 6px 10px; margin: -8px -10px 8px -10px; border-top-left-radius: 8px; border-top-right-radius: 8px; font-weight: bold; font-size: 13px; text-align: center;'&gt;DOCUMENT&lt;div style='font-size: 10px; font-weight: normal; opacity: 0.85;'&gt;Collection: documents&lt;/div&gt;&lt;/div&gt;&lt;div style='font-size: 11px; line-height: 1.45; font-family: monospace;'&gt;&lt;div&gt;&lt;b&gt;+ _id&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;ObjectId&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[PK]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ userId&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;ObjectId&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[FK -&gt; User (Owner)]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ filename&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Stored Filename]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ originalName&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Display Name]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ fileType&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;SupportedDocumentFormat&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Enum: pdf|docx|txt|md|csv...]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ mimeType&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[MIME Format]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ fileSize&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;number&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Bytes]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ storagePath&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Disk Path]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ folder&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[FK -&gt; Folder.name]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ allowedDepartments&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string[]&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[ACL Department Array]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ status&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;DocumentStatus&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Enum: pending|processing|ready...]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ chunkCount&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;number&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Vector Chunks Count]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ sourceType&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;string&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;['narrative' | 'tabular']&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ createdAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;+ updatedAt&lt;/b&gt;: &lt;span style='color: #2563eb;'&gt;Date&lt;/span&gt; &lt;span style='color: #6b7280; font-size: 10px;'&gt;[Timestamp]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;snapToPoint=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontFamily=Helvetica;">
